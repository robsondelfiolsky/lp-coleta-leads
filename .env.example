# =============================================================================
# Example environment variables for this app.
# Copy to .env.local and fill in real values. .env.local is in .gitignore.
#
# The <skyone-config-panel> chat tag (or the Skyone Database settings
# card) populates these automatically — you usually don't edit by hand.
# =============================================================================

# Skyone Database (Postgres-wire bridge over DuckDB) — default for AI-built apps.
# POSTGRES_URL=postgresql://user:pass@db.skyone.example.com:9000/mydatabase?sslmode=require
# SKYONE_DB_DIALECT=duckdb

# Local PostgreSQL fallback.
# POSTGRES_URL=postgresql://user:pass@localhost:5432/mydatabase

# Local SQLite fallback (single-file).
# SQLITE_PATH=./data.db

# Local DuckDB fallback (single-file).
# DUCKDB_PATH=./data.duckdb
